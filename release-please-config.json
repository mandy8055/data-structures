{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "pull-request-title-pattern": "build(main): 🚀 release v${version}",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "✨ Features",
      "hidden": false
    },
    {
      "type": "fix",
      "section": "🐛 Bug Fixes",
      "hidden": false
    },
    {
      "type": "docs",
      "section": "📝 Documentation",
      "hidden": true
    },
    {
      "type": "perf",
      "section": "✅ Others",
      "hidden": true
    },
    {
      "type": "refactor",
      "section": "✅ Others",
      "hidden": true
    },
    {
      "type": "test",
      "section": "✅ Others",
      "hidden": true
    },
    {
      "type": "build",
      "section": "✅ Others",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "✅ Others",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "✅ Others",
      "hidden": true
    },
    {
      "type": "security",
      "section": "✅ Others",
      "hidden": true
    }
  ],
  "extra-files": [
    {
      "type": "json",
      "path": "deno.json",
      "jsonpath": "$.version"
    }
  ],
  "packages": {
    ".": {
      "exclude-paths": [
        "website"
      ]
    }
  }
}
